<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <ClInclude Include="$(MSBuildThisFileDirectory)DxilVertexHistory.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)RovCaptureShader.h" />
    <ClCompile Include="$(MSBuildThisFileDirectory)DxilVertexHistory.cpp" />
    <ClInclude Include="$(MSBuildThisFileDirectory)GeometryPipeline.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)GeometryInstance.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)GeometryPipelineCache.h" />
    <ClCompile Include="$(MSBuildThisFileDirectory)GeometryPipelineCache.cpp" />
    <ClInclude Include="$(MSBuildThisFileDirectory)DetourThreads.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)GeometryCreation.h" />
    <ClCompile Include="$(MSBuildThisFileDirectory)GeometryCreation.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)GeometryHost.cpp" />
    <ClInclude Include="$(MSBuildThisFileDirectory)GeometryObjectRegistry.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)CyberpunkObjects.h" />
    <ClCompile Include="$(MSBuildThisFileDirectory)CyberpunkObjects.cpp" />
    <ClInclude Include="$(MSBuildThisFileDirectory)GraphicsRootBindings.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)CyberpunkCamera.h" />
    <ClCompile Include="$(MSBuildThisFileDirectory)GeometryPipeline.cpp">
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\..\..\external\FidelityFX-SDK\sdk\tools\ffx_shader_compiler\libs\dxc\inc;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <ClInclude Include="$(MSBuildThisFileDirectory)MaterialCaptureBlend.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)GlassSurfaceGpu.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)GlassRegionGpu.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)GlassFgPass.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)CyberpunkSurfacePass.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)SurfaceQueueLink.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)ComputeRecording.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)NativeSession.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)CommandLifetime.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)D3D12Observer.h" />
    <ClCompile Include="$(MSBuildThisFileDirectory)D3D12Observer.cpp" />
    <ClInclude Include="$(MSBuildThisFileDirectory)NativeHost.h" />
    <ClCompile Include="$(MSBuildThisFileDirectory)NativeHost.cpp" />
    <ClInclude Include="$(MSBuildThisFileDirectory)TaggedInputs.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)StreamlineTagBridge.h" />
    <ClCompile Include="$(MSBuildThisFileDirectory)StreamlineTagBridge.cpp" />
    <None Include="$(MSBuildThisFileDirectory)StreamlineTagBridge.LICENSE.txt" />
    <ClCompile Include="$(MSBuildThisFileDirectory)GlassFgCompile.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)GlassSettings.cpp" />
    <ClInclude Include="$(MSBuildThisFileDirectory)GlassControls.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)GlassGpuTimer.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)SurfaceSnapshotPool.h" />
    <None Include="$(MSBuildThisFileDirectory)GlassSurface.hlsl" />
    <None Include="$(MSBuildThisFileDirectory)GlassRegion.hlsl" />
  </ItemGroup>
  <Target Name="CopyGlassShaders" AfterTargets="Build">
    <MakeDir Directories="$(TargetDir)Glass" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)GlassSurface.hlsl;$(MSBuildThisFileDirectory)GlassRegion.hlsl"
          DestinationFolder="$(TargetDir)Glass" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\shaders\shader_tools\dxcompiler.dll;$(MSBuildThisFileDirectory)..\..\shaders\shader_tools\dxil.dll"
          DestinationFolder="$(TargetDir)Glass" SkipUnchangedFiles="true" />
    <!-- Upstream moves the Release DLL into a/ before packaging. -->
    <MakeDir Directories="$(SolutionDir)x64\Release\a\Glass" Condition="'$(Configuration)|$(Platform)'=='Release|x64'" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)GlassSurface.hlsl;$(MSBuildThisFileDirectory)GlassRegion.hlsl"
          DestinationFolder="$(SolutionDir)x64\Release\a\Glass" SkipUnchangedFiles="true"
          Condition="'$(Configuration)|$(Platform)'=='Release|x64'" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\shaders\shader_tools\dxcompiler.dll;$(MSBuildThisFileDirectory)..\..\shaders\shader_tools\dxil.dll"
          DestinationFolder="$(SolutionDir)x64\Release\a\Glass" SkipUnchangedFiles="true"
          Condition="'$(Configuration)|$(Platform)'=='Release|x64'" />
  </Target>
</Project>
